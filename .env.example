# Neon Auth (a integração da Vercel fornece o endpoint automaticamente)
NEON_AUTH_BASE_URL=

# Segredo usado para assinar o cache de sessão no servidor (32+ caracteres)
NEON_AUTH_COOKIE_SECRET=

# Connection string pooled do Neon
# A integração Neon/Vercel também pode fornecer POSTGRES_URL.
DATABASE_URL=

# Token da Blob Store privada da Vercel para documentos
BLOB_READ_WRITE_TOKEN=
# Chave base64url de 32 bytes para criptografar tokens das integrações por organização.
INTEGRATIONS_ENCRYPTION_KEY=
